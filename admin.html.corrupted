            async function handleCreateExam() {
                const title = document.getElementById('exam-title').value.trim();
                const description = document.getElementById('exam-desc').value.trim();
                const teacherSel = document.getElementById('exam-teacher-select');
                const teacherId = teacherSel.value;
                const teacherName = teacherSel.options[teacherSel.selectedIndex].text;
                const duration = parseInt(document.getElementById('exam-duration').value) || 30;
                const grades = [...document.querySelectorAll('input[name="exam-grades-check"]:checked')].map(cb => cb.value);
                const questions = collectExamQuestions();

                if (!title) { toast('ÙŠØ±Ø¬Ù‰ Ø¥Ø¯Ø®Ø§Ù„ Ø¹Ù†ÙˆØ§Ù† Ø§Ù„Ø§Ù…ØªØ­Ø§Ù†', 'error'); return; }
                if (!teacherId) { toast('ÙŠØ±Ø¬Ù‰ Ø§Ø®ØªÙŠØ§Ø± Ø§Ù„Ù…Ø¹Ù„Ù…', 'error'); return; }
                if (grades.length === 0) { toast('ÙŠØ±Ø¬Ù‰ Ø§Ø®ØªÙŠØ§Ø± ØµÙ Ø¯Ø±Ø§Ø³ÙŠ ÙˆØ§Ø­Ø¯ Ø¹Ù„Ù‰ Ø§Ù„Ø£Ù‚Ù„', 'error'); return; }
                if (!questions) { toast('ÙŠØ±Ø¬Ù‰ Ù…Ù„Ø¡ Ø¬Ù…ÙŠØ¹ Ø­Ù‚ÙˆÙ„ Ø§Ù„Ø£Ø³Ø¦Ù„Ø© Ø¨Ø´ÙƒÙ„ ÙƒØ§Ù…Ù„', 'error'); return; }
                if (questions.length === 0) { toast('ÙŠØ±Ø¬Ù‰ Ø¥Ø¶Ø§ÙØ© Ø³Ø¤Ø§Ù„ ÙˆØ§Ø­Ø¯ Ø¹Ù„Ù‰ Ø§Ù„Ø£Ù‚Ù„', 'error'); return; }

                const teacher = _teachers.find(t => t._id === teacherId);
                const subject = teacher ? teacher.subjectAr : '';

                // Calculate total marks: MCQ/TF get 1 mark, essay gets 1 mark (customizable inside grading)
                const totalMarks = questions.length;

                toast('Ø¬Ø§Ø±ÙŠ Ø­ÙØ¸ Ø§Ù„Ø§Ù…ØªØ­Ø§Ù†...', 'info');
                try {
                    const res = await fetch(`${API}/api/exams`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ title, description, teacherId, teacherName, subject, grades, duration, totalMarks, questions })
                    });
                    const d = await res.json();
                    if (d.success) {
                        toast('ØªÙ… Ø¥Ù†Ø´Ø§Ø¡ Ø§Ù„Ø§Ù…ØªØ­Ø§Ù† Ø¨Ù†Ø¬Ø§Ø­!', 'success');
                        clearExamForm();
                        loadExamsAdmin();
                        showExamSubSection('manage-exams', document.getElementById('nav-sub-manage-exams'));
                    } else {
                        toast('Ø®Ø·Ø£: ' + d.message, 'error');
                    }
                } catch (e) {
                    toast('Ø®Ø·Ø£ ÙÙŠ Ø§Ù„Ø§ØªØµØ§Ù„ Ø¨Ø§Ù„Ø³ÙŠØ±ÙØ±', 'error');
                }
            }

            function clearExamForm() {
                document.getElementById('exam-title').value = '';
                document.getElementById('exam-desc').value = '';
                document.getElementById('exam-teacher-select').value = '';
                document.getElementById('exam-duration').value = '30';
                document.querySelectorAll('input[name="exam-grades-check"]').forEach(cb => {
                    cb.checked = false;
                    cb.closest('.grade-pill').classList.remove('checked');
                });
                document.getElementById('exam-questions-container').innerHTML = `
                    <p style="color:var(--txt3); font-size:13px; text-align:center; padding:20px;">
                        Ø§Ø¶ØºØ· "Ø§Ø®ØªÙŠØ§Ø± Ù…ØªØ¹Ø¯Ø¯" Ø£Ùˆ "ØµØ­ / Ø®Ø·Ø£" Ø£Ùˆ "Ø³Ø¤Ø§Ù„ Ù…Ù‚Ø§Ù„ÙŠ" Ø£Ùˆ "Ø§Ø³ØªØ®Ø±Ø§Ø¬ Ù…Ù† Ù…Ù„Ù" Ù„Ù„Ø¨Ø¯Ø¡
                    </p>`;
