            // Ø§Ø³ØªØ¯Ø¹Ø§Ø¡ ÙÙˆØ±ÙŠ Ù„Ù†ØªØ§Ø¦Ø¬ Ø§Ù„ØªØµÙÙŠØ©
            function loadExamResultsFromFilter() {
