                // Populate videos dropdown filtered by selected Teacher and Grade
                const prevSelectedVideo = videoSel.value;
                videoSel.innerHTML = '<option value="">ÙƒÙ„ Ø§Ù„ÙÙŠØ¯ÙŠÙˆÙ‡Ø§Øª</option>';

                let filteredVideos = [..._videos];
                if (tFilter) filteredVideos = filteredVideos.filter(v => v.teacherId === tFilter);
                if (gFilter) filteredVideos = filteredVideos.filter(v => v.grades && v.grades.includes(gFilter));

                filteredVideos.forEach(v => {
                    const isSelected = v._id === prevSelectedVideo ? 'selected' : '';
                    videoSel.innerHTML += `<option value="${v._id}" ${isSelected}>${v.title}</option>`;
                });
