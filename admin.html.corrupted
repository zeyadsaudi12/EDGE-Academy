            function populateCodesFilters() {
                const teacherSel = document.getElementById('code-filter-teacher');
                const videoSel = document.getElementById('code-filter-video');
                if (!teacherSel || !videoSel) return;

                const tFilter = teacherSel.value;
                const gFilter = document.getElementById('code-filter-grade')?.value || '';

                // Populate teachers dropdown if empty
                if (teacherSel.options.length <= 1) {
                    teacherSel.innerHTML = '<option value="">ÙƒÙ„ Ø§Ù„Ù…Ø¹Ù„Ù…ÙŠÙ†</option>';
                    _teachers.forEach(t => {
