            // ===== SECURITY GUARD (Ø§Ù„Ø­Ø§Ø¬Ø² Ø§Ù„Ø£Ù…Ù†ÙŠ Ù„Ø­Ù…Ø§ÙŠØ© Ù„ÙˆØ­Ø© Ø§Ù„Ø¥Ø¯Ø§Ø±Ø©) =====
            const currentUserGuard = JSON.parse(localStorage.getItem('currentUser'));
