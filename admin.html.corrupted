            function renderCodesPanels() {
                const tFilter = document.getElementById('code-filter-teacher')?.value || '';
                const gFilter = document.getElementById('code-filter-grade')?.value || '';
                const vFilter = document.getElementById('code-filter-video')?.value || '';

                // Filter codes list based on selected dropdown values
                let filteredCodes = [..._codes];

                if (tFilter || gFilter || vFilter) {
                    filteredCodes = filteredCodes.filter(c => {
                        const video = _videos.find(v => v._id === c.videoId);
                        if (!video) return false;

                        if (tFilter && video.teacherId !== tFilter) return false;
                        if (gFilter && !(video.grades && video.grades.includes(gFilter))) return false;
                        if (vFilter && c.videoId !== vFilter) return false;

                        return true;
                    });
                }

                const activated = filteredCodes.filter(c => c.used || c.views > 0);
                const notActivated = filteredCodes.filter(c => !(c.used || c.views > 0));
                document.getElementById('codes-count-label').textContent = `${filteredCodes.length} ÙƒÙˆØ¯ Ù…ØµÙÙ‰ (Ù…Ù† Ø¥Ø¬Ù…Ø§Ù„ÙŠ ${_codes.length}) | ${activated.length} Ù…ÙØ¹Ù‘Ù„ | ${notActivated.length} ØºÙŠØ± Ù…ÙØ¹Ù‘Ù„`;

