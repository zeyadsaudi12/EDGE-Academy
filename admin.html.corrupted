        renderViolationsTable(); // Ø³Ø·Ø± Ø§Ù„ØªØ­Ø¯ÙŠØ« Ø§Ù„Ù…Ø¶Ø§Ù
    }

            // ØªØ¹Ø¨Ø¦Ø© ÙÙ„ØªØ± Ø§Ù„Ù…Ø¹Ù„Ù…ÙŠÙ† Ø¯Ø§Ø®Ù„ ØµÙØ­Ø© Ø§Ù„ØªØ­ÙƒÙ… Ø¨Ø§Ù„ÙÙŠØ¯ÙŠÙˆÙ‡Ø§Øª
            function populateManageFilters() {
                const sel = document.getElementById('manage-teacher-select');
                if (!sel) return;
                sel.innerHTML = '<option value="">ÙƒÙ„ Ø§Ù„Ù…Ø¹Ù„Ù…ÙŠÙ†</option>';
                _teachers.forEach(t => {
                    sel.innerHTML += `<option value="${t._id}">${t.name}</option>`;
