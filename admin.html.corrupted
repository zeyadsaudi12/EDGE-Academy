        // 1. Ø¯Ø§Ù„Ø© ÙØªØ­ Ù…ÙˆØ¯Ø§Ù„ ØªØ¹Ø¯ÙŠÙ„ Ø¨ÙŠØ§Ù†Ø§Øª Ø§Ù„Ù…Ø¹Ù„Ù… (Ù†Ø³Ø®Ø© Ù‚ÙŠØ§Ø³ÙŠØ©)
            function openEditTeacherModal(id) {
                const teacher = _teachers.find(t => t._id === id);
                if (!teacher) return;
                
                document.getElementById('edit-teacher-id').value = teacher._id;
