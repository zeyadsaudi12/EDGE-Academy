            // ===== NAVIGATION =====
            let _onlinePollInterval = null;

            async function loadOnlineUsers() {
                const loadingEl  = document.getElementById('online-users-loading');
                const tblWrapper = document.getElementById('online-users-table-wrapper');
                const emptyState = document.getElementById('online-users-empty');
                const errorState = document.getElementById('online-users-error');
                const tbody      = document.getElementById('online-users-tbody');
                const badge      = document.getElementById('online-count-badge');

                // Show loading, hide others
                if (loadingEl)  loadingEl.style.display  = 'flex';
                if (tblWrapper) tblWrapper.style.display  = 'none';
                if (emptyState) emptyState.style.display  = 'none';
                if (errorState) errorState.style.display  = 'none';

                try {
                    // Timeout after 10 seconds
                    const controller = new AbortController();
                    const timeout = setTimeout(() => controller.abort(), 10000);

                    const res = await fetch(`${API}/api/users/online`, { signal: controller.signal });
                    clearTimeout(timeout);

                    const onlineUsers = await res.json();

                    if (loadingEl) loadingEl.style.display = 'none';

                    if (!onlineUsers || onlineUsers.length === 0) {
                        if (tblWrapper) tblWrapper.style.display = 'none';
                        if (emptyState) emptyState.style.display = 'flex';
                        if (badge) badge.style.display = 'none';
                        return;
                    }

                    if (tblWrapper) tblWrapper.style.display = 'block';
                    if (emptyState) emptyState.style.display = 'none';

                    // Update badge
                    if (badge) {
                        badge.style.display = 'inline';
                        badge.textContent = onlineUsers.length;
                    }

                    // Update sidebar nav badge
                    const navBadge = document.getElementById('nav-online-count');
                    if (navBadge) navBadge.textContent = onlineUsers.length;

                    tbody.innerHTML = onlineUsers.map(u => {
                        const lastActiveRaw = u.lastActive;
                        let lastActiveDate;
                        // MongoDB UTCDateTime comes as {$date: ms} or ISO string
                        if (lastActiveRaw && typeof lastActiveRaw === 'object' && lastActiveRaw['$date']) {
                            lastActiveDate = new Date(lastActiveRaw['$date']);
                        } else {
                            lastActiveDate = new Date(lastActiveRaw);
                        }
                        const lastActiveTime = lastActiveDate.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
                        const secondsAgo = Math.round((Date.now() - lastActiveDate.getTime()) / 1000);
                        const agoText = secondsAgo < 60 ? `Ù…Ù†Ø° ${secondsAgo} Ø«Ø§Ù†ÙŠØ©` : `Ù…Ù†Ø° ${Math.round(secondsAgo/60)} Ø¯Ù‚ÙŠÙ‚Ø©`;
                        return `
                    <tr>
                        <td style="font-weight: 700; color: var(--accent);">${u.firstName || ''} ${u.lastName || ''}</td>
                        <td>${u.phone || 'â€”'}</td>
                        <td><span class="badge" style="background: var(--bg3); color: var(--txt1);">${u.grade || 'â€”'}</span></td>
                        <td style="direction: ltr;">${agoText} (${lastActiveTime})</td>
                        <td>
                            <span style="display: inline-flex; align-items: center; gap: 6px; color: #2ca772; font-weight: 700; font-size: 0.85rem;">
                                <span style="width: 8px; height: 8px; background: #2ca772; border-radius: 50%; animation: pulse 1.5s infinite; display: inline-block;"></span>
                                Ù†Ø´Ø· Ø§Ù„Ø¢Ù†
                            </span>
                        </td>
                    </tr>
                `;
                    }).join('');
                } catch (err) {
                    if (loadingEl) loadingEl.style.display = 'none';
                    if (err.name === 'AbortError') {
                        // Timeout - show error
                        if (errorState) errorState.style.display = 'flex';
                    } else {
                        console.error('Error loading online users:', err);
                        if (errorState) errorState.style.display = 'flex';
                    }
                }
            }

