            // Ø±Ù†Ø¯Ø± Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ù…Ø­Ø§Ø¶Ø±Ø§Øª Ù„Ù„ØªØ­ÙƒÙ… Ø¨Ù‡Ø§
            function renderManageVideosTable() {
                const tb = document.getElementById('manage-videos-table-body');
                if (!tb) return;

                const tFilter = document.getElementById('manage-teacher-select').value;
                const gFilter = document.getElementById('manage-grade-select').value;

                let list = [..._videos];
                if (tFilter) list = list.filter(v => v.teacherId === tFilter);
                if (gFilter) list = list.filter(v => v.grades && v.grades.includes(gFilter));

                if (!list.length) {
                    tb.innerHTML = '<tr><td colspan="6" style="text-align:center; padding: 40px; color: var(--txt3);">Ù„Ø§ ØªÙˆØ¬Ø¯ Ù…Ø­Ø§Ø¶Ø±Ø§Øª ØªØ·Ø§Ø¨Ù‚ Ø§Ù„ÙÙ„Ø§ØªØ± Ø§Ù„Ù…Ø­Ø¯Ø¯Ø©</td></tr>';
                    return;
                }

                tb.innerHTML = list.map(v => {
                    const teacher = _teachers.find(t => t._id === v.teacherId);
                    const tName = teacher ? teacher.name : 'â€”';
                    const statusBadge = v.closed
                        ? '<span class="badge badge-red">Ù…ØºÙ„Ù‚Ø© ðŸ”’</span>'
                        : '<span class="badge badge-green">Ù…ÙØªÙˆØ­Ø© ðŸ”“</span>';
                    const visibilityBadge = v.hidden
                        ? '<span class="badge badge-red">Ù…Ø®ÙÙŠØ© ðŸ‘ï¸â€ðŸ—¨ï¸</span>'
                        : '<span class="badge badge-green">Ù…Ø±Ø¦ÙŠØ© ðŸ‘ï¸</span>';

                   return `
            <tr>
                <td style="font-weight:600; color:var(--txt)">${v.title}</td>
                <td>${tName}</td>
                <td>${v.price || 0} Ø¬.Ù…</td>
                <td><div style="display:flex; flex-wrap:wrap; gap:4px;">${(v.grades || []).map(g => `<span class="badge badge-blue" style="font-size:10px; padding:2px 6px;">${g.replace('Ø§Ù„ØµÙ ', '')}</span>`).join('')}</div></td>
                <td><div style="display:flex; flex-direction:column; gap:4px;">${statusBadge}${visibilityBadge}</div></td>
                <td>
                    <div class="action-btns">
                        <button class="action-btn" onclick="openWatchersModal('${v._id}', '${v.title.replace(/'/g, "\\'")}')" title="Ø¹Ø±Ø¶ Ø§Ù„Ù…Ø´ØªØ±ÙƒÙŠÙ† ÙˆØ§Ù„Ù…Ø´Ø§Ù‡Ø¯ÙŠÙ†">
                            <i class="ti ti-users"></i>
                        </button>
                        <button class="action-btn" onclick="toggleVideoStatus('${v._id}')" title="${v.closed ? 'ÙØªØ­ Ù„Ù„Ù…Ø´Ø§Ù‡Ø¯Ø©' : 'Ù‚ÙÙ„ Ø§Ù„Ù…Ø´Ø§Ù‡Ø¯Ø©'}">
                            <i class="ti ${v.closed ? 'ti-lock-open' : 'ti-lock'}"></i>
                        </button>
                        <button class="action-btn" onclick="toggleVideoVisibility('${v._id}')" title="${v.hidden ? 'Ø¥Ø¸Ù‡Ø§Ø± Ù„Ù„Ø·Ù„Ø§Ø¨' : 'Ø¥Ø®ÙØ§Ø¡ Ø¹Ù† Ø§Ù„Ø·Ù„Ø§Ø¨'}">
                            <i class="ti ${v.hidden ? 'ti-eye' : 'ti-eye-off'}"></i>
                        </button>
                        <button class="action-btn" onclick="openEditVideoModal('${v._id}')" title="ØªØ¹Ø¯ÙŠÙ„">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button class="action-btn danger" onclick="confirmDeleteVideo('${v._id}','${v.title}')" title="Ø­Ø°Ù">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
                }).join('');
            }

