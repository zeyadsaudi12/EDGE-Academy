            // ØªØ­Ø¯ÙŠØ« Ø§Ù…ØªØ­Ø§Ù†Ø§Øª Ø§Ù„ÙÙ„ØªØ± Ø¨Ù†Ø§Ø¡Ù‹ Ø¹Ù„Ù‰ Ø§Ù„Ù…Ø¯Ø±Ø³ ÙˆØ§Ù„Ù…Ø±Ø­Ù„Ø©
            function onResultsFilterChange() {
                const tId = document.getElementById('results-filter-teacher').value;
