            let _activeWatchersList = []; // Ù…ØµÙÙˆÙØ© Ù„Ø­ÙØ¸ Ø§Ù„Ù…Ø´Ø§Ù‡Ø¯ÙŠÙ† Ø§Ù„Ø­Ø§Ù„ÙŠÙŠÙ† ÙˆØªØµÙÙŠØªÙ‡Ù… ÙˆØªØµØ¯ÙŠØ±Ù‡Ù…

