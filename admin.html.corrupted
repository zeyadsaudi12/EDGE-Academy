            // ===== THEME SWITCHER =====
            function toggleAdminTheme() {
                const isLight = document.body.classList.contains('light-mode');
                const newTheme = isLight ? 'dark' : 'light';
                applyAdminTheme(newTheme);
            }

            function applyAdminTheme(theme) {
                document.body.classList.toggle('light-mode', theme === 'light');
                localStorage.setItem('adminTheme', theme);
            }

            function getAdminTheme() {
                const saved = localStorage.getItem('adminTheme');
                if (saved === 'dark' || saved === 'light') return saved;
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }

            // ===== INIT =====

            // Ø¯Ø§Ù„Ø© Ø®ÙÙŠÙØ© Ù„ØªØ­Ø¯ÙŠØ« Ø¹Ø¯Ø§Ø¯ Ø§Ù„Ù€ sidebar ÙÙ‚Ø· Ø¨Ø¯ÙˆÙ† ØªØ­Ù…ÙŠÙ„ ÙƒÙ„ Ø§Ù„Ø¨ÙŠØ§Ù†Ø§Øª
            async function updateOnlineBadge() {
                try {
                    const controller = new AbortController();
                    const timeout = setTimeout(() => controller.abort(), 8000);
                    const res = await fetch(`${API}/api/users/online`, { signal: controller.signal });
                    clearTimeout(timeout);
                    const data = await res.json();
                    const count = Array.isArray(data) ? data.length : 0;
                    const navBadge = document.getElementById('nav-online-count');
                    if (navBadge) navBadge.textContent = count;
                } catch (_) {}
            }

            document.addEventListener('DOMContentLoaded', function () {
                applyAdminTheme(getAdminTheme());
                loadAll();
                // ØªØ­Ø¯ÙŠØ« Ø¹Ø¯Ø§Ø¯ Ø§Ù„Ø£ÙˆÙ†Ù„Ø§ÙŠÙ† ÙÙˆØ± ÙØªØ­ Ø§Ù„ØµÙØ­Ø© ÙˆÙƒÙ„ 30 Ø«Ø§Ù†ÙŠØ©
                updateOnlineBadge();
                setInterval(updateOnlineBadge, 30000);
            }, { once: true });




