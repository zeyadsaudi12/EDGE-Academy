            // ØªØ¹Ø¨Ø¦Ø© ÙÙ„ØªØ± Ø§Ù„Ù…Ø¯Ø±Ø³ÙŠÙ† ÙÙŠ Ù„ÙˆØ­Ø© Ø§Ù„Ù†ØªØ§Ø¦Ø¬
            function populateResultsFilters() {
