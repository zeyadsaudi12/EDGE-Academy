            // Ø¹Ø±Ø¶ ØªÙØ§ØµÙŠÙ„ Ù†ØªØ§Ø¦Ø¬ Ø§Ù„Ø§Ù…ØªØ­Ø§Ù† Ø§Ù„Ù…Ø®ØªØ§Ø± ÙˆØ¥ÙŠØ¯Ø§Ø¹Ù‡Ø§ Ù„Ù„ÙÙ„ØªØ±Ø©
            async function viewExamResults(examId, examTitle) {
                _activeExamId = examId; // ðŸŒŸ ØªØ®Ø²ÙŠÙ† Ø§Ù„Ù…Ø¹Ø±Ù‘Ù Ø§Ù„Ù†Ø´Ø· ÙÙˆØ±Ø§Ù‹ Ù„Ù…Ù†Ø¹ Ø§Ù„Ø£Ø®Ø·Ø§Ø¡
                const panel = document.getElementById('exam-results-panel');
