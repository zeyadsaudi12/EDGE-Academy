                    <td style="padding:10px;"><span class="badge badge-blue" style="font-size:10px;">${w.grade.replace('Ø§Ù„ØµÙ ', '')}</span></td>
                    <td style="padding:10px;">${w.governorate}</td>
                </tr>
            `).join('');
        };

        // ØªØµØ¯ÙŠØ± Ù‚Ø§Ø¦Ù…Ø© Ø§Ù„Ø·Ù„Ø§Ø¨ Ø§Ù„Ù…Ø´ØªØ±ÙƒÙŠÙ† ÙƒÙ…Ù„Ù Excel/CSV Ø¨Ø¶ØºØ·Ø© Ø²Ø±
        window.exportWatchersCSV = function () {
            if (_activeWatchersList.length === 0) {
                toast('Ù„Ø§ ØªÙˆØ¬Ø¯ Ø¨ÙŠØ§Ù†Ø§Øª Ø·Ù„Ø§Ø¨ Ù„ØªØµØ¯ÙŠØ±Ù‡Ø§ Ù„Ù‡Ø°Ù‡ Ø§Ù„Ù…Ø­Ø§Ø¶Ø±Ø©', 'error');
                return;
            }
            const videoTitle = document.getElementById('watcher-video-title').textContent || 'watchers';
            let csv = '\uFEFFØ§Ø³Ù… Ø§Ù„Ø·Ø§Ù„Ø¨,Ø±Ù‚Ù… Ø§Ù„Ù‡Ø§ØªÙ,Ø§Ù„ØµÙ Ø§Ù„Ø¯Ø±Ø§Ø³ÙŠ,Ø§Ù„Ù…Ø­Ø§ÙØ¸Ø©\n';
            _activeWatchersList.forEach(w => {
                csv += `"${w.name || ''}",${w.phone || ''},"${w.grade || ''}","${w.governorate || ''}"\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `Ù…Ø´ØªØ±ÙƒÙŠÙ†_${videoTitle}_${Date.now()}.csv`;
            a.click();
            toast('ØªÙ… ØªØµØ¯ÙŠØ± Ù…Ù„Ù Ù…Ø´ØªØ±ÙƒÙŠÙ† Ø§Ù„Ù…Ø­Ø§Ø¶Ø±Ø© Ø¨Ù†Ø¬Ø§Ø­! ðŸ“¥', 'success');
        };
            
        </script>
        
