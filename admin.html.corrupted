                    if (type === 'mcq') {
                        const optsInputs = [...div.querySelectorAll('.q-opt')];
                        const opts = optsInputs.map(o => o.value.trim());

                        // Ø§Ù„ØªØ­Ù‚Ù‚ Ù…Ù† Ø§Ù„Ø­Ù‚ÙˆÙ„ Ø§Ù„ÙØ§Ø±ØºØ© ÙˆØªØ­Ø¯ÙŠØ¯ Ø§Ù„Ø­Ù‚Ù„ Ø§Ù„ÙØ§Ø±Øº Ø¨Ø§Ù„ØªØ­Ø¯ÙŠØ¯ Ù„Ù…Ø³Ø§Ø¹Ø¯ØªÙƒ
                        const emptyIndex = opts.indexOf('');
                        if (emptyIndex !== -1) {
                            const optNames = ['Ø£', 'Ø¨', 'Ø¬', 'Ø¯'];
                            errorMsg = `Ø§Ù„Ø³Ø¤Ø§Ù„ Ø±Ù‚Ù… ${qNum} ÙŠØ­ØªÙˆÙŠ Ø¹Ù„Ù‰ Ø®ÙŠØ§Ø± ÙØ§Ø±Øº (Ø§Ù„Ø®ÙŠØ§Ø± ${optNames[emptyIndex]}). ÙŠØ±Ø¬Ù‰ Ù…Ù„Ø¡ Ø¬Ù…ÙŠØ¹ Ø§Ù„Ø®ÙŠØ§Ø±Ø§Øª Ø§Ù„Ø£Ø±Ø¨Ø¹Ø©.`;
                            break;
                        }
                        questions.push({ text, type, options: opts, correctAnswer });
                    } else if (type === 'truefalse') {
                        questions.push({ text, type, options: ['ØµØ­', 'Ø®Ø·Ø£'], correctAnswer });
                    } else {
                        questions.push({ text, type, options: [], correctAnswer: correctAnswer || '' });
