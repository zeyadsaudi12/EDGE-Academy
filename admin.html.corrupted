                    overview: ['Ù†Ø¸Ø±Ø© Ø¹Ø§Ù…Ø©', 'Ø¥Ø­ØµØ§Ø¦ÙŠØ§Øª Ø§Ù„Ù…Ù†ØµØ© Ø§Ù„Ø´Ø§Ù…Ù„Ø©'],
                    users: ['Ø§Ù„Ø·Ù„Ø§Ø¨', 'Ù‚Ø§Ø¦Ù…Ø© Ø§Ù„Ø·Ù„Ø§Ø¨ Ø§Ù„Ù…Ø³Ø¬Ù„ÙŠÙ†'],
                    codes: ['Ø¥Ø¯Ø§Ø±Ø© Ø§Ù„Ø£ÙƒÙˆØ§Ø¯', 'ØªØªØ¨Ø¹ ÙˆØ¥Ø¯Ø§Ø±Ø© Ø£ÙƒÙˆØ§Ø¯ Ø§Ù„Ø´Ø­Ù†'],
                    online: ['Ø§Ù„Ù…ØªØµÙ„ÙˆÙ† Ø§Ù„Ø¢Ù†', 'Ø§Ù„Ø·Ù„Ø§Ø¨ Ø§Ù„Ù†Ø´Ø·ÙˆÙ† Ø¹Ù„Ù‰ Ø§Ù„Ù…Ù†ØµØ©'],
                    'add-video': ['Ø¥Ø¶Ø§ÙØ© ÙÙŠØ¯ÙŠÙˆ', 'Ø±ÙØ¹ Ù…Ø­Ø§Ø¶Ø±Ø© Ø¬Ø¯ÙŠØ¯Ø© Ù„Ù„Ù…Ù†ØµØ©'],
                    'generate-codes': ['ØªÙˆÙ„ÙŠØ¯ Ø£ÙƒÙˆØ§Ø¯', 'Ø¥Ù†Ø´Ø§Ø¡ ÙˆØªØµØ¯ÙŠØ± Ø£ÙƒÙˆØ§Ø¯ Ø§Ù„Ø´Ø­Ù†'],
                    'add-teacher': ['Ø¥Ø¶Ø§ÙØ© Ù…Ø¹Ù„Ù…ÙŠÙ†', 'Ø£Ø¶Ù Ù…Ø¹Ù„Ù…Ø§Ù‹ Ø¬Ø¯ÙŠØ¯Ø§Ù‹ Ù„Ù„Ù…Ù†ØµØ©'],
                    'edit-teachers': ['ØªØ¹Ø¯ÙŠÙ„ Ø§Ù„Ù…Ø¹Ù„Ù…ÙŠÙ†', 'ØªØ¹Ø¯ÙŠÙ„ ÙˆØ­Ø°Ù Ø§Ù„Ù…Ø¹Ù„Ù…ÙŠÙ† Ø§Ù„Ù…Ø¶Ø§ÙÙŠÙ†'],
                    teachers: ['Ø¥Ø¯Ø§Ø±Ø© Ø§Ù„Ù…Ø¹Ù„Ù…ÙŠÙ†', 'Ø¥Ø¶Ø§ÙØ© ÙˆØ­Ø°Ù Ø§Ù„Ù…Ø¹Ù„Ù…ÙŠÙ†'],
                    'manage-videos': ['Ø§Ù„ØªØ­ÙƒÙ… Ø¨Ø§Ù„ÙÙŠØ¯ÙŠÙˆÙ‡Ø§Øª', 'Ø¥Ø¯Ø§Ø±Ø© ÙˆØªØ¹Ø¯ÙŠÙ„ ÙˆÙ‚ÙÙ„ Ø§Ù„ÙÙŠØ¯ÙŠÙˆÙ‡Ø§Øª Ø§Ù„Ù…Ø±ÙÙˆØ¹Ø©'],
                    exams: ['Ø¥Ø¯Ø§Ø±Ø© Ø§Ù„Ø§Ù…ØªØ­Ø§Ù†Ø§Øª', 'Ø¥Ù†Ø´Ø§Ø¡ Ø§Ù„Ø§Ù…ØªØ­Ø§Ù†Ø§Øª ÙˆØ¹Ø±Ø¶ Ù†ØªØ§Ø¦Ø¬ Ø§Ù„Ø·Ù„Ø§Ø¨'],
                    banners: ['Ø¥Ø¹Ù„Ø§Ù†Ø§Øª Ø§Ù„Ù‡ÙŠØ±Ùˆ', 'Ø¥Ø¯Ø§Ø±Ø© Ø§Ù„ØµÙˆØ± Ø§Ù„Ø¥Ø¹Ù„Ø§Ù†ÙŠØ© Ø¹Ù„Ù‰ Ø§Ù„ØµÙØ­Ø© Ø§Ù„Ø±Ø¦ÙŠØ³ÙŠØ©']
                };
                const [title, sub] = titles[name] || ['Ù„ÙˆØ­Ø© Ø§Ù„ØªØ­ÙƒÙ…', ''];
