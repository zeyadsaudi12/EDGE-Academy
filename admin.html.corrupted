                            <td style="direction:ltr;">${r.studentPhone || 'â€”'}</td>
                            <td style="font-weight:700;">${r.score}</td>
                            <td>
                                <span style="color:${r.percentage >= 50 ? 'var(--green)' : 'var(--accent2)'}; font-weight:700;">
                                    ${r.percentage}%
                                </span>
                            </td>
                            <td style="color:${statusColor}; font-weight:600;">${statusText}</td>
                            <td>${new Date(r.submittedAt).toLocaleDateString('ar-EG')}</td>
                            <td>
                                <div style="display:flex; gap:6px;">
                                    <button class="topbar-btn" style="padding:4px 8px; font-size:11px;" onclick="openGradeEssayModal('${examId}', '${r.studentId}', '${r.studentName}')">
                                        <i class="ti ti-checklist"></i> ØªØµØ­ÙŠØ­ Ø§Ù„Ù…Ù‚Ø§Ù„ÙŠ
                                    </button>
                                    <button class="topbar-btn" style="padding:4px 8px; font-size:11px; color:var(--accent2); border-color:rgba(230,57,70,0.3);" onclick="resetStudentAttempt('${examId}', '${r.studentId}', '${r.studentName}')">
                                        <i class="ti ti-refresh"></i> Ø¥Ø¹Ø§Ø¯Ø© Ø§Ù„Ø§Ù…ØªØ­Ø§Ù†
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

        // Ù…Ø³Ø§Ø± Ø­Ø°Ù ÙˆØ¥Ø¹Ø§Ø¯Ø© ØªØ¹ÙŠÙŠÙ† Ù…Ø­Ø§ÙˆÙ„Ø© Ø§Ù„Ø·Ø§Ù„Ø¨ Ø§Ù„Ø¨Ø±Ù…Ø¬ÙŠØ© Ù…Ù† Ø§Ù„Ù…Ø´Ø±Ù (Ù†Ø³Ø®Ø© Ø¢Ù…Ù†Ø© ÙˆÙ…Ø·ÙˆØ±Ø©)
            function resetStudentAttempt(examId, studentId, studentName) {
                showModal(
                    'Ø¥Ø¹Ø§Ø¯Ø© ØªØ¹ÙŠÙŠÙ† Ø§Ù„Ø§Ù…ØªØ­Ø§Ù†', 
                    `Ù‡Ù„ Ø£Ù†Øª Ù…ØªØ£ÙƒØ¯ Ù…Ù† Ø­Ø°Ù Ù…Ø­Ø§ÙˆÙ„Ø© Ø§Ù„Ø·Ø§Ù„Ø¨ "${studentName}" ÙˆØ§Ù„Ø³Ù…Ø§Ø­ Ù„Ù‡ Ø¨Ø¥Ø¹Ø§Ø¯Ø© Ù‡Ø°Ø§ Ø§Ù„Ø§Ù…ØªØ­Ø§Ù† Ù…Ø±Ø© Ø£Ø®Ø±Ù‰ØŸ`, 
                    async () => {
                        try {
                            const res = await fetch(`${API}/api/exams/${examId}/results/${studentId}`, {
                                method: 'DELETE'
                            });
                            
                            // ØªØ­Ù‚Ù‚ Ø£Ù…Ù†ÙŠ: Ø¥Ø°Ø§ ÙƒØ§Ù†Øª Ø§Ù„Ø§Ø³ØªØ¬Ø§Ø¨Ø© ØºÙŠØ± Ù†Ø§Ø¬Ø­Ø© (Ù…Ø«Ù„ 404 Ø£Ùˆ 500)
                            if (!res.ok) {
                                const errText = await res.text();
                                console.error("ØªÙØ§ØµÙŠÙ„ Ø®Ø·Ø£ Ø§Ù„Ø³ÙŠØ±ÙØ±:", errText);
                                toast(`Ø­Ø¯Ø« Ø®Ø·Ø£ ÙÙŠ Ø§Ù„Ø³ÙŠØ±ÙØ± Ø¨ÙƒÙˆØ¯: ${res.status} (ØªØ£ÙƒØ¯ Ù…Ù† Ø¥Ø¹Ø§Ø¯Ø© ØªØ´ØºÙŠÙ„ Ø§Ù„Ø³ÙŠØ±ÙØ±)`, 'error');
                                return;
                            }

                            const d = await res.json();
                            if (d.success) {
                                toast('ØªÙ… Ø­Ø°Ù Ø§Ù„Ù…Ø­Ø§ÙˆÙ„Ø© ÙˆØ§Ù„Ø³Ù…Ø§Ø­ Ù„Ù„Ø·Ø§Ù„Ø¨ Ø¨Ø¥Ø¹Ø§Ø¯Ø© Ø§Ù„Ø§Ù…ØªØ­Ø§Ù† Ø¨Ù†Ø¬Ø§Ø­', 'success');
                                // ØªØ­Ø¯ÙŠØ« ÙÙˆØ±ÙŠ Ù„Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ù†ØªØ§Ø¦Ø¬ Ø§Ù„Ù…Ø¹Ø±ÙˆØ¶ ÙˆØ§Ù„Ø¹Ø¯Ø§Ø¯Ø§Øª Ø¨Ø§Ù„Ø¥Ø¯Ø§Ø±Ø©
                                viewExamResults(examId, document.getElementById('exam-results-title').textContent);
                                loadExamsAdmin();
                            } else {
                                toast('ÙØ´Ù„ Ø§Ù„ØªØ¹Ø¯ÙŠÙ„: ' + d.message, 'error');
                            }
                        } catch (e) {
                            console.error("Ø®Ø·Ø£ Ø§Ù„Ø§ØªØµØ§Ù„:", e);
                            toast('Ø®Ø·Ø£ ÙÙŠ Ø§Ù„Ø§ØªØµØ§Ù„ Ø¨Ø§Ù„Ø®Ø§Ø¯Ù…ØŒ ØªØ£ÙƒØ¯ Ù…Ù† ØªØ´ØºÙŠÙ„ Ø§Ù„Ø³ÙŠØ±ÙØ± ÙˆÙ…Ø²Ø§Ù…Ù†Ø© Ø§Ù„ÙƒÙˆØ¯', 'error');
                        }
                    }
                );
            }
            // ØªØµØ¯ÙŠØ± ÙÙˆØ±ÙŠ Ù„Ù†ØªØ§Ø¦Ø¬ Ø§Ù„Ø§Ù…ØªØ­Ø§Ù† Ø§Ù„Ø­Ø§Ù„ÙŠ ÙƒÙ…Ù„Ù CSV Ø§Ù„Ù…Ø¯Ù…Ø¬ Ø¨Ø¨Ø±Ù†Ø§Ù…Ø¬ Excel
            function exportResultsCSV() {
                if (!_currentResults || _currentResults.length === 0) {
                    toast('Ù„Ø§ ØªÙˆØ¬Ø¯ Ù†ØªØ§Ø¦Ø¬ Ù„ØªØµØ¯ÙŠØ±Ù‡Ø§ Ù„Ù‡Ø°Ø§ Ø§Ù„Ø§Ù…ØªØ­Ø§Ù†', 'error');
                    return;
                }
                const examTitle = document.getElementById('exam-results-title').textContent || 'results';
                let csv = '\uFEFFØ§Ø³Ù… Ø§Ù„Ø·Ø§Ù„Ø¨,Ø±Ù‚Ù… Ø§Ù„Ù‡Ø§ØªÙ,Ø§Ù„Ø¯Ø±Ø¬Ø©,Ø§Ù„Ù†Ø³Ø¨Ø©,Ø§Ù„Ø­Ø§Ù„Ø©,ØªØ§Ø±ÙŠØ® Ø§Ù„ØªØ³Ù„ÙŠÙ…\n';
                _currentResults.forEach(r => {
                    const status = r.isGraded ? 'ØªÙ… Ø§Ù„ØªØµØ­ÙŠØ­' : 'Ù‚ÙŠØ¯ Ø§Ù„Ù…Ø±Ø§Ø¬Ø¹Ø©';
                    const date = new Date(r.submittedAt).toLocaleDateString('ar-EG');
                    csv += `"${r.studentName || ''}",${r.studentPhone || ''},${r.score},${r.percentage}%,${status},${date}\n`;
                });
                const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `Ù†ØªØ§Ø¦Ø¬_${examTitle}_${Date.now()}.csv`;
                a.click();
                toast('ØªÙ… ØªØµØ¯ÙŠØ± Ù…Ù„Ù Ø§Ù„Ù†ØªØ§Ø¦Ø¬ Ø¨Ù†Ø¬Ø§Ø­!', 'success');
            }

            function closeGradeEssayModal() {
                document.getElementById('gradeEssayModal').classList.remove('open');
            }

            async function openGradeEssayModal(examId, studentId, studentName) {
                document.getElementById('grade-student-name').textContent = studentName;
                document.getElementById('grade-exam-id').value = examId;
                document.getElementById('grade-student-id').value = studentId;

                const fields = document.getElementById('essay-grading-fields');
                fields.innerHTML = '<p style="text-align:center;">Ø¬Ø§Ø±ÙŠ Ø§Ù„ØªØ­Ù…ÙŠÙ„...</p>';
                document.getElementById('gradeEssayModal').classList.add('open');

                try {
                    const res = await fetch(`${API}/api/exams/${examId}`);
                    const d = await res.json();
                    if (!d.success) { toast('Ø®Ø·Ø£ ÙÙŠ ØªØ­Ù…ÙŠÙ„ Ø¨ÙŠØ§Ù†Ø§Øª Ø§Ù„Ø§Ù…ØªØ­Ø§Ù†', 'error'); return; }

                    const exam = d.exam;
                    const result = exam.results.find(r => r.studentId === studentId);

                    let html = '';
                    let hasEssays = false;
                    exam.questions.forEach((q, i) => {
                        if (q.type === 'essay') {
                            hasEssays = true;
                            const studentAns = result.answers[i] || 'Ù„Ù… ÙŠØªÙ… ØªÙ‚Ø¯ÙŠÙ… Ø¥Ø¬Ø§Ø¨Ø©';
                            const currentScore = (result.essayScores && result.essayScores.find(s => s.questionIndex === i)?.score) || 0;
                            html += `
                                <div style="background:var(--bg2); border:1px solid var(--border2); border-radius:10px; padding:12px; margin-bottom:10px; text-align:right;">
                                    <div style="font-weight:700; margin-bottom:8px; color:var(--txt);">Ø³${i + 1}: ${q.text}</div>
                                    <div style="font-size:12px; color:var(--txt2); background:var(--bg3); padding:8px; border-radius:6px; margin-bottom:8px; white-space:pre-wrap;">
                                        <strong>Ø¥Ø¬Ø§Ø¨Ø© Ø§Ù„Ø·Ø§Ù„Ø¨:</strong><br>${studentAns}
                                    </div>
                                    ${q.correctAnswer ? `
                                    <div style="font-size:11px; color:var(--teal); margin-bottom:8px;">
                                        ðŸ’¡ <strong>Ø§Ù„Ø¥Ø¬Ø§Ø¨Ø© Ø§Ù„Ù†Ù…ÙˆØ°Ø¬ÙŠØ©:</strong> ${q.correctAnswer}
                                    </div>
                                    ` : ''}
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <label style="font-size:12px; font-weight:700;">Ø¯Ø±Ø¬Ø© Ø§Ù„Ø³Ø¤Ø§Ù„:</label>
                                        <input type="number" class="essay-score-input" data-index="${i}" value="${currentScore}" min="0" step="0.5" style="width:80px; padding:5px; background:var(--bg3); border:1px solid var(--border2); border-radius:6px; color:var(--txt);">
                                    </div>
                                </div>
                            `;
                        }
                    });
                    fields.innerHTML = html || '<p style="text-align:center; padding:20px; color:var(--txt3);">Ù„Ø§ ØªÙˆØ¬Ø¯ Ø£Ø³Ø¦Ù„Ø© Ù…Ù‚Ø§Ù„ÙŠØ© ÙÙŠ Ù‡Ø°Ø§ Ø§Ù„Ø§Ù…ØªØ­Ø§Ù† Ù„ØªØµØ­ÙŠØ­Ù‡Ø§</p>';
                } catch (err) {
                    fields.innerHTML = '<p style="color:red; text-align:center;">Ø®Ø·Ø£ ÙÙŠ Ø§Ù„Ø§ØªØµØ§Ù„ Ø¨Ø§Ù„Ø®Ø§Ø¯Ù…</p>';
                }
            }

            async function handleSaveEssayGrades(event) {
                event.preventDefault();
                const examId = document.getElementById('grade-exam-id').value;
                const studentId = document.getElementById('grade-student-id').value;
                const inputs = document.querySelectorAll('.essay-score-input');

                const grades = {};
                inputs.forEach(input => {
                    const idx = input.getAttribute('data-index');
                    grades[idx] = parseFloat(input.value) || 0;
                });

                toast('Ø¬Ø§Ø±ÙŠ Ø­ÙØ¸ Ø§Ù„Ø¯Ø±Ø¬Ø§Øª ÙˆØªØ­Ø¯ÙŠØ« Ø§Ù„Ù†ØªÙŠØ¬Ø©...', 'info');
                try {
                    const res = await fetch(`${API}/api/exams/${examId}/grade-essay`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ studentId, grades })
                    });
                    const d = await res.json();
                    if (d.success) {
                        toast('ØªÙ… Ø­ÙØ¸ Ø§Ù„Ø¯Ø±Ø¬Ø§Øª ÙˆØªØ­Ø¯ÙŠØ« Ù†ØªÙŠØ¬Ø© Ø§Ù„Ø·Ø§Ù„Ø¨ Ø¨Ù†Ø¬Ø§Ø­', 'success');
                        closeGradeEssayModal();
                        viewExamResults(examId, document.getElementById('exam-results-title').textContent);
                    } else {
                        toast('Ø®Ø·Ø£: ' + d.message, 'error');
                    }
                } catch (e) {
                    toast('Ø­Ø¯Ø« Ø®Ø·Ø£ ÙÙŠ Ø§Ù„Ø§ØªØµØ§Ù„', 'error');
                }
            }

            function populateExamTeacherSelect() {
