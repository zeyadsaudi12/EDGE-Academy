            function collectExamQuestions() {
                const container = document.getElementById('exam-questions-container');
                const qDivs = container.querySelectorAll('[id^="exam-q-"]');
                const questions = [];
                let errorMsg = null;

                for (let i = 0; i < qDivs.length; i++) {
                    const div = qDivs[i];
                    const qNum = i + 1; // Ø±Ù‚Ù… Ø§Ù„Ø³Ø¤Ø§Ù„ Ø§Ù„Ø­Ø§Ù„ÙŠ Ù„ØªØ¨Ø³ÙŠØ·Ù‡ ÙÙŠ Ø§Ù„ØªÙ†Ø¨ÙŠÙ‡
                    const text = div.querySelector('.q-text').value.trim();
                    const type = div.querySelector('.q-type').value;
                    const correctAnswer = div.querySelector('.q-correct').value;

                    if (!text) {
                        errorMsg = `Ø§Ù„Ø³Ø¤Ø§Ù„ Ø±Ù‚Ù… ${qNum} Ù„Ø§ ÙŠØ­ØªÙˆÙŠ Ø¹Ù„Ù‰ Ù†Øµ. ÙŠØ±Ø¬Ù‰ Ø¥Ø¯Ø®Ø§Ù„ Ù†Øµ Ø§Ù„Ø³Ø¤Ø§Ù„.`;
                        break;
