                panel.style.display = 'block';
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px; color:var(--txt3);">Ø¬Ø§Ø±ÙŠ Ø§Ù„ØªØ­Ù…ÙŠÙ„...</td></tr>';
                panel.scrollIntoView({ behavior: 'smooth' });
                try {
                    const res = await fetch(`${API}/api/exams/${examId}/results`);
                    const d = await res.json();
                    _currentResults = d.results || []; // Ø­ÙØ¸ Ø§Ù„Ù†ØªØ§Ø¦Ø¬ Ù„ØªØµÙÙŠØªÙ‡Ø§ Ù…Ø­Ù„ÙŠØ§Ù‹ ÙˆØªØµØ¯ÙŠØ±Ù‡Ø§

                    filterResultsTable(); // Ø±Ù†Ø¯Ø± ÙÙˆØ±ÙŠ Ù„Ù„Ø¬Ø¯ÙˆÙ„
                } catch (e) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:red;">Ø®Ø·Ø£ ÙÙŠ ØªØ­Ù…ÙŠÙ„ Ø§Ù„Ù†ØªØ§Ø¦Ø¬</td></tr>';
                }
            }

            // Ù…Ø­Ø±Ùƒ Ø§Ù„Ø¨Ø­Ø« Ø§Ù„ÙÙˆØ±ÙŠ ÙˆØªØµÙÙŠØ© Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ù†ØªØ§Ø¦Ø¬ Ø¨Ø§Ù„Ø¥Ø¯Ø§Ø±Ø©
            function filterResultsTable() {
                const query = document.getElementById('result-search-input').value.toLowerCase().trim();
                const tbody = document.getElementById('exam-results-table');
                if (!tbody || !_currentResults) return;

                let filtered = [..._currentResults];
                if (query) {
                    filtered = filtered.filter(r =>
                        (r.studentName || '').toLowerCase().includes(query) ||
                        (r.studentPhone || '').includes(query)
                    );
                }

                if (filtered.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px; color:var(--txt3);">Ù„Ø§ ØªÙˆØ¬Ø¯ Ù†ØªØ§Ø¦Ø¬ Ù…Ø·Ø§Ø¨Ù‚Ø©</td></tr>';
                    return;
                }

                tbody.innerHTML = filtered.map(r => {
                    const statusText = r.isGraded ? 'ØªÙ… Ø§Ù„ØªØµØ­ÙŠØ­ âœ“' : 'â³ Ù…Ø¹Ù„Ù‚ Ù„Ù„ØªØµØ­ÙŠØ­';
                    const statusColor = r.isGraded ? 'var(--green)' : 'var(--gold)';
                    const examId = _activeExamId; // ðŸŒŸ Ø¬Ù„Ø¨ Ø§Ù„Ù…Ø¹Ø±Ù‘Ù Ø§Ù„Ù†Ø´Ø· Ù…Ø¨Ø§Ø´Ø±Ø© Ù…Ù† Ø§Ù„Ù…ØªØºÙŠØ± Ø§Ù„Ø¹Ø§Ù…

                    return `
                        <tr>
