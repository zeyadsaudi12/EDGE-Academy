            function filterTeachersAdmin(q) {
                const el = document.getElementById('teachers-list-admin');
                const query = (q || '').toLowerCase().trim();
                const filtered = query
                    ? _teachers.filter(t =>
                        (t.name || '').toLowerCase().includes(query) ||
                        (t.subjectAr || '').toLowerCase().includes(query)
                    )
                    : _teachers;

                if (!filtered.length) {
                    el.innerHTML = '<div class="empty-state"><i class="ti ti-user-x"></i><p>Ù„Ø§ ØªÙˆØ¬Ø¯ Ù†ØªØ§Ø¦Ø¬ Ù…Ø·Ø§Ø¨Ù‚Ø©</p></div>';
                    return;
                }

                el.innerHTML = filtered.map(t => {
                    const initials = (t.name || 'Ù…').split(' ').map(w => w[0]).slice(0, 2).join('');
                    const gradesArray = Array.isArray(t.grades) ? t.grades : [];
                    const grades = gradesArray.map(g => `<span class="teacher-grade-tag">${g.replace('Ø§Ù„ØµÙ ', '')}</span>`).join('');
                    const scheduleCount = Array.isArray(t.schedule) ? t.schedule.length : 0;
                    const followers = _followerCounts[t._id] || 0;

                    return `<div class="teacher-row">
                        <div class="teacher-avatar-placeholder">${initials}</div>
                        <div class="teacher-info">
                            <div class="teacher-name-text">${t.name}</div>
                            <div class="teacher-meta">${t.subjectAr || ''} Â· ${t.bio || ''}</div>
                            <div class="teacher-grades" style="margin-top:6px">${grades}</div>
                            ${scheduleCount > 0 ? `<div style="font-size:11px; color:var(--teal); margin-top:4px;"><i class="ti ti-calendar"></i> ${scheduleCount} Ù…ÙŠØ¹Ø§Ø¯ Ø¨Ø§Ù„Ø³Ù†ØªØ±</div>` : ''}
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:center; gap:4px; min-width:64px;">
                            <span style="font-size:22px; font-weight:700; color:var(--accent);">${followers}</span>
                            <span style="font-size:11px; color:var(--txt2);">Ù…ØªØ§Ø¨Ø¹</span>
                        </div>
                        <div class="action-btns">
                            <button class="action-btn" onclick="openEditTeacherModal('${t._id}')" title="ØªØ¹Ø¯ÙŠÙ„"><i class="ti ti-edit"></i></button>
                            <button class="action-btn danger" onclick="confirmDeleteTeacher('${t._id}','${t.name}')" title="Ø­Ø°Ù"><i class="ti ti-trash"></i></button>
                        </div>
                    </div>`;
                }).join('');
            }

