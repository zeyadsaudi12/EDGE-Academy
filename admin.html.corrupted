                        <option value="Ø§Ù„Ø£Ø±Ø¨Ø¹Ø§Ø¡" ${day === 'Ø§Ù„Ø£Ø±Ø¨Ø¹Ø§Ø¡' ? 'selected' : ''}>Ø§Ù„Ø£Ø±Ø¨Ø¹Ø§Ø¡</option>
                        <option value="Ø§Ù„Ø®Ù…ÙŠØ³" ${day === 'Ø§Ù„Ø®Ù…ÙŠØ³' ? 'selected' : ''}>Ø§Ù„Ø®Ù…ÙŠØ³</option>
                        <option value="Ø§Ù„Ø¬Ù…Ø¹Ø©" ${day === 'Ø§Ù„Ø¬Ù…Ø¹Ø©' ? 'selected' : ''}>Ø§Ù„Ø¬Ù…Ø¹Ø©</option>
