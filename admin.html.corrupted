            // ===== GENERATE CODES =====
            function populateVideoSelectAdmin() {
                const sel = document.querySelector('#section-generate-codes select[name="videoSelect"]');
                if (!sel) return;
                sel.innerHTML = '<option value="">-- Ø§Ø®ØªØ± ÙÙŠØ¯ÙŠÙˆ --</option>';
                _videos.forEach(v => { sel.innerHTML += `<option value="${v._id}">${v.title}</option>`; });
            }

            function setPrice(videoId) {
                const video = _videos.find(v => v._id === videoId);
                if (video) document.getElementById('code-price').value = video.price;
            }

            function handleGenerateCodes(event) {
                event.preventDefault();
                const form = event.target;
                const videoId = form.querySelector('select[name="videoSelect"]').value;
                const count = parseInt(form.querySelector('input[name="count"]').value);
                const value = parseInt(form.querySelector('input[name="price"]').value);
                if (!videoId) { toast('ÙŠØ±Ø¬Ù‰ Ø§Ø®ØªÙŠØ§Ø± ÙÙŠØ¯ÙŠÙˆ', 'error'); return; }
                const video = _videos.find(v => v._id === videoId);
                const videoTitle = video ? video.title : 'ÙÙŠØ¯ÙŠÙˆ';
                toast(`Ø¬Ø§Ø±ÙŠ ØªÙˆÙ„ÙŠØ¯ ${count} ÙƒÙˆØ¯...`, 'info');
                fetch(`${API}/api/codes/generate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ videoId, videoTitle, count, value })
                }).then(r => r.json()).then(d => {
                    if (d.success) {
                        _lastGenCodes = d.codes;
                        toast(`ØªÙ… ØªÙˆÙ„ÙŠØ¯ ${d.codes.length} ÙƒÙˆØ¯ Ø¨Ù†Ø¬Ø§Ø­!`, 'success');
                        showGenResult(d.codes);
                        exportCodesCSV(d.codes);
                        loadAll();
                    } else toast('Ø®Ø·Ø£: ' + d.message, 'error');
                }).catch(() => toast('Ø®Ø·Ø£ ÙÙŠ Ø§Ù„Ø§ØªØµØ§Ù„', 'error'));
            }

            function showGenResult(codes) {
                const el = document.getElementById('gen-result');
                el.style.display = 'block';
                document.getElementById('gen-count').textContent = codes.length;
                document.getElementById('gen-codes-display').innerHTML = codes.map(c =>
                    `<div class="gen-code-chip">${c.code}</div>`
                ).join('');
            }

            function copyAllCodes() {
                const text = _lastGenCodes.map(c => c.code).join('\n');
                navigator.clipboard.writeText(text).then(() => toast('ØªÙ… Ù†Ø³Ø® Ø§Ù„Ø£ÙƒÙˆØ§Ø¯', 'success'));
            }

            function exportCodesCSV(codes) {
                let csv = '\uFEFFØ§Ù„ÙƒÙˆØ¯,Ø§Ù„Ù‚ÙŠÙ…Ø©,Ø§Ù„ÙÙŠØ¯ÙŠÙˆ\n';
                codes.forEach(c => { csv += `${c.code},${c.value},"${c.videoTitle}"\n`; });
                const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `codes_${Date.now()}.csv`;
                a.click();
            }

            // ===== EXAMS MANAGEMENT =====
            let _examQuestions = [];
