                document.getElementById('edit-teacher-subject').value = teacher.subjectAr || '';
                document.getElementById('edit-teacher-bio').value = teacher.bio || '';
                
                // ØªÙØ±ÙŠØº ÙˆØ¨Ù†Ø§Ø¡ Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ù…ÙˆØ§Ø¹ÙŠØ¯
                const container = document.getElementById('schedule-rows-container');
                container.innerHTML = '';
                if (teacher.schedule && Array.isArray(teacher.schedule)) {
