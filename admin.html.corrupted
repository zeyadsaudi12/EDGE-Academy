        window.openWatchersModal = function (id, videoTitle) {
            document.getElementById('watcher-video-title').textContent = videoTitle;
            document.getElementById('watcher-search-input').value = '';
            
            const tbody = document.getElementById('video-watchers-table');
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 20px; color: var(--txt3);">Ø¬Ø§Ø±ÙŠ Ø¬Ù„Ø¨ Ø§Ù„Ù…Ø´Ø§Ù‡Ø¯ÙŠÙ† Ù…Ù† Ù‚Ø§Ø¹Ø¯Ø© Ø§Ù„Ø¨ÙŠØ§Ù†Ø§Øª...</td></tr>';
            
            document.getElementById('videoWatchersModal').classList.add('open');

            fetch(`${API}/api/videos/${id}/watchers`)
                .then(r => r.json())
                .then(d => {
                    if (d.success) {
                        _activeWatchersList = d.watchers || [];
                        filterWatchersTable(); // Ø±Ù†Ø¯Ø±Ø© ÙˆØªØµÙÙŠØ© Ø§Ù„Ø¬Ø¯ÙˆÙ„
                    } else {
                        tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; color:var(--accent2); padding: 20px;">Ø®Ø·Ø£: ${d.message}</td></tr>`;
                    }
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color:var(--accent2); padding: 20px;">Ø®Ø·Ø£ ÙÙŠ Ø§Ù„Ø§ØªØµØ§Ù„ Ø¨Ø§Ù„Ù…Ù†ØµØ©</td></tr>';
                });
        };

        window.closeWatchersModal = function () {
            document.getElementById('videoWatchersModal').classList.remove('open');
        };

        // ØªØµÙÙŠØ© ÙˆØ¹Ø±Ø¶ Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ù…Ø´Ø§Ù‡Ø¯ÙŠÙ† Ø¨Ù†Ø§Ø¡Ù‹ Ø¹Ù„Ù‰ Ù…Ø±Ø¨Ø¹ Ø§Ù„Ø¨Ø­Ø« Ø§Ù„ÙÙˆØ±ÙŠ
        window.filterWatchersTable = function () {
            const query = document.getElementById('watcher-search-input').value.toLowerCase().trim();
            const tbody = document.getElementById('video-watchers-table');
            
            let filtered = [..._activeWatchersList];
            if (query) {
                filtered = filtered.filter(w => 
                    (w.name || '').toLowerCase().includes(query) || 
                    (w.phone || '').includes(query)
                );
            }

            if (filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 20px; color: var(--txt3);">Ù„Ø§ ØªÙˆØ¬Ø¯ Ù†ØªØ§Ø¦Ø¬ Ù…Ø·Ø§Ø¨Ù‚Ø© Ù„Ø¨Ø­Ø«Ùƒ</td></tr>';
                return;
            }

            tbody.innerHTML = filtered.map(w => `
