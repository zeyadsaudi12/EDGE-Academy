                _pendingConfirm = onConfirm;
            }
            function closeModal() { document.getElementById('confirmModal').classList.remove('open'); _pendingConfirm = null; }
            document.getElementById('modal-confirm-btn').onclick = () => { if (_pendingConfirm) _pendingConfirm(); closeModal(); };

            // ===== GRADE PILLS =====
