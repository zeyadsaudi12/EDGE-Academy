            window.addScheduleRow = function(center = '', day = 'Ø§Ù„Ø³Ø¨Øª', grade = 'Ø§Ù„ØµÙ Ø§Ù„Ø£ÙˆÙ„ Ø§Ù„Ø«Ø§Ù†ÙˆÙŠ', time = '10:00 Øµ') {
