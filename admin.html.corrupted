    <!DOCTYPE html>
    <html lang="ar" dir="rtl">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Ù„ÙˆØ­Ø© ØªØ­ÙƒÙ… MASAR</title>
        <script src="https://unpkg.com/html5-qrcode" defer></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;900&display=swap');

            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --bg: #0f1117;
                --bg2: #1a1d27;
                --bg3: #22263a;
                --surface: #2a2f47;
                --accent: #dda852;
                --accent2: #ff6b6b;
                --gold: #f4a261;
                --teal: #2ec4b6;
                --blue: #4361ee;
                --green: #06d6a0;
                --purple: #7b2d8b;
                --txt: #e8eaf0;
                --txt2: #9ba3c0;
                --txt3: #5c6480;
                --border: rgba(255, 255, 255, 0.07);
                --border2: rgba(255, 255, 255, 0.13);
                --shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
                --radius: 14px;
                --radius-sm: 8px;
                --sidebar-w: 260px;
            }

            /* ===== LIGHT MODE ===== */
            body.light-mode {
                --bg: #f0f2f8;
                --bg2: #ffffff;
                --bg3: #f5f6fa;
                --surface: #ebedf5;
                --txt: #1a1d2e;
                --txt2: #4a5070;
                --txt3: #8a91b0;
                --border: rgba(0, 0, 0, 0.07);
                --border2: rgba(0, 0, 0, 0.12);
                --shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            }

            body {
                font-family: 'Cairo', sans-serif;
                background: var(--bg);
                color: var(--txt);
                min-height: 100vh;
                display: flex;
                overflow-x: hidden;
                flex-direction: column;
            }

            /* ===== SIDEBAR ===== */
            .sidebar {
                width: var(--sidebar-w);
                background: var(--bg2);
                border-left: 1px solid var(--border);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 64px;
                right: 0;
                bottom: 0;
                z-index: 100;
                overflow-y: auto;
            }

            .sidebar-logo {
                padding: 28px 24px 20px;
                border-bottom: 1px solid var(--border);
            }

            .sidebar-logo .brand {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .logo-icon {
                width: 42px;
                height: 42px;
                background: linear-gradient(135deg, var(--accent), var(--gold));
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: 900;
                color: #fff;
            }

            .brand-name {
                font-size: 18px;
                font-weight: 700;
                color: var(--txt);
            }

            .brand-sub {
                font-size: 11px;
                color: var(--txt3);
                margin-top: 2px;
            }

            .sidebar-stats {
                padding: 16px 16px 8px;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }

            .mini-stat {
                background: var(--bg3);
                border: 1px solid var(--border);
                border-radius: var(--radius-sm);
                padding: 10px 12px;
                text-align: center;
            }

            .mini-stat .val {
                font-size: 20px;
                font-weight: 700;
                color: var(--txt);
            }

            .mini-stat .lbl {
                font-size: 10px;
                color: var(--txt3);
                margin-top: 2px;
            }

            .sidebar-nav {
                padding: 12px 12px;
                flex: 1;
            }

            .nav-group-title {
                font-size: 10px;
                color: var(--txt3);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 1px;
                padding: 16px 12px 8px;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 14px;
                border-radius: var(--radius-sm);
                cursor: pointer;
                color: var(--txt2);
                font-size: 14px;
                font-weight: 500;
                transition: all 0.18s ease;
                margin-bottom: 3px;
                border: 1px solid transparent;
                background: none;
                width: 100%;
                text-align: right;
            }

            .nav-item:hover {
                background: var(--bg3);
                color: var(--txt);
            }

            .nav-item.active {
                background: rgba(221, 168, 82, 0.12);
                color: var(--accent);
                border-color: rgba(221, 168, 82, 0.25);
            }

            .nav-item i {
                font-size: 18px;
                flex-shrink: 0;
            }

            .nav-badge {
                margin-right: auto;
                background: var(--accent);
                color: #fff;
                font-size: 10px;
                padding: 2px 7px;
                border-radius: 20px;
                font-weight: 700;
            }

            /* ===== NAV DROPDOWN ===== */
            .nav-dropdown {
                position: relative;
                width: 100%;
            }

            .nav-dropdown-toggle {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 14px;
                border-radius: var(--radius-sm);
                cursor: pointer;
                color: var(--txt2);
                font-size: 14px;
                font-weight: 500;
                transition: all 0.18s ease;
                margin-bottom: 3px;
                border: 1px solid transparent;
                background: none;
                width: 100%;
                text-align: right;
            }

            .nav-dropdown-toggle:hover {
                background: var(--bg3);
                color: var(--txt);
            }

            .nav-dropdown-toggle.has-active {
                background: rgba(221, 168, 82, 0.12);
                color: var(--accent);
                border-color: rgba(221, 168, 82, 0.25);
            }

            .nav-dropdown-toggle .arrow {
                margin-right: auto;
                font-size: 12px;
                transition: transform 0.25s ease;
                color: var(--txt3);
            }

            .nav-dropdown.open .nav-dropdown-toggle .arrow {
                transform: rotate(180deg);
            }

            .nav-dropdown-menu {
                display: none;
                flex-direction: column;
                gap: 2px;
                padding: 4px 0 4px 10px;
                margin-bottom: 4px;
                border-right: 2px solid rgba(221, 168, 82, 0.3);
                margin-right: 22px;
            }

            .nav-dropdown.open .nav-dropdown-menu {
                display: flex;
                animation: dropdownFadeIn 0.2s ease;
            }

            @keyframes dropdownFadeIn {
                from { opacity: 0; transform: translateY(-6px); }
                to { opacity: 1; transform: translateY(0); }
            }

            .nav-sub-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 9px 12px;
                border-radius: var(--radius-sm);
                cursor: pointer;
                color: var(--txt2);
                font-size: 13px;
                font-weight: 500;
                transition: all 0.15s ease;
                border: 1px solid transparent;
                background: none;
                width: 100%;
                text-align: right;
            }

            .nav-sub-item:hover {
                background: var(--bg3);
                color: var(--txt);
            }

            .nav-sub-item.active {
                background: rgba(221, 168, 82, 0.1);
                color: var(--accent);
                border-color: rgba(221, 168, 82, 0.2);
            }

            .nav-sub-item i {
                font-size: 14px;
                flex-shrink: 0;
            }

            .sidebar-footer {
                padding: 16px;
                border-top: 1px solid var(--border);
            }

            .logout-btn {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 14px;
                border-radius: var(--radius-sm);
                background: rgba(230, 57, 70, 0.1);
                border: 1px solid rgba(230, 57, 70, 0.25);
                color: var(--accent2);
                cursor: pointer;
                font-size: 14px;
                font-weight: 500;
                width: 100%;
                text-align: right;
                transition: all 0.18s;
            }

            .logout-btn:hover {
                background: rgba(230, 57, 70, 0.2);
            }

            /* ===== MAIN ===== */
            .main {
                flex: 1;
                margin-right: var(--sidebar-w);
                display: flex;
                flex-direction: column;
                min-height: calc(100vh - 64px);
            }

            /* ===== TOPBAR ===== */
            .topbar {
                background: var(--bg2);
                border-bottom: 1px solid var(--border);
                padding: 0 32px;
                height: 64px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 90;
            }

            .topbar-title {
                font-size: 18px;
                font-weight: 700;
                color: var(--txt);
            }

            .topbar-subtitle {
                font-size: 12px;
                color: var(--txt3);
                margin-top: 2px;
            }

            .topbar-actions {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .topbar-btn {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 16px;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border2);
                background: var(--bg3);
                color: var(--txt2);
                cursor: pointer;
                font-size: 13px;
                font-weight: 500;
                font-family: 'Cairo', sans-serif;
                transition: all 0.18s;
            }

            .topbar-btn:hover {
                border-color: var(--accent);
                color: var(--accent2);
            }

            .topbar-btn.primary {
                background: var(--accent);
                border-color: var(--accent);
                color: #fff;
            }

            .topbar-btn.primary:hover {
                background: var(--accent2);
            }

            /* ===== CONTENT ===== */
            .content {
                padding: 28px 32px;
                flex: 1;
            }

            .section {
                display: none;
            }

            .section.active {
                display: block;
            }

            /* ===== KPI CARDS ===== */
            .kpi-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 16px;
                margin-bottom: 28px;
            }

            .kpi-card {
                background: var(--bg2);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 20px 22px;
                position: relative;
                overflow: hidden;
                transition: border-color 0.2s;
            }

            .kpi-card:hover {
                border-color: var(--border2);
            }

            .kpi-card::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 60px;
                height: 60px;
                border-radius: 0 var(--radius) 0 60px;
                opacity: 0.12;
            }

            .kpi-card.red::before {
                background: var(--accent);
            }

            .kpi-card.gold::before {
                background: var(--gold);
            }

            .kpi-card.teal::before {
                background: var(--teal);
            }

            .kpi-card.blue::before {
                background: var(--blue);
            }

            .kpi-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                margin-bottom: 14px;
            }

            .kpi-card.red .kpi-icon {
                background: rgba(230, 57, 70, 0.15);
                color: var(--accent2);
            }

            .kpi-card.gold .kpi-icon {
                background: rgba(244, 162, 97, 0.15);
                color: var(--gold);
            }

            .kpi-card.teal .kpi-icon {
                background: rgba(46, 196, 182, 0.15);
                color: var(--teal);
            }

            .kpi-card.blue .kpi-icon {
                background: rgba(67, 97, 238, 0.15);
                color: #7b9eff;
            }

            .kpi-val {
                font-size: 30px;
                font-weight: 700;
                color: var(--txt);
                line-height: 1;
            }

            .kpi-lbl {
                font-size: 12px;
                color: var(--txt3);
                margin-top: 6px;
            }

            .kpi-change {
                font-size: 11px;
                margin-top: 8px;
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .kpi-change.up {
                color: var(--green);
            }

            .kpi-change.down {
                color: var(--accent2);
            }

            /* ===== DATA TABLE ===== */
            .table-card {
                background: var(--bg2);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                overflow: hidden;
            }

            .table-header {
                padding: 18px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .table-header h3 {
                font-size: 15px;
                font-weight: 600;
                color: var(--txt);
            }

            .table-header p {
                font-size: 12px;
                color: var(--txt3);
                margin-top: 3px;
            }

            .table-toolbar {
                padding: 12px 22px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .search-input {
                flex: 1;
                background: var(--bg3);
                border: 1px solid var(--border2);
                border-radius: var(--radius-sm);
                padding: 8px 14px 8px 36px;
                color: var(--txt);
                font-size: 13px;
                font-family: 'Cairo', sans-serif;
                position: relative;
            }

            .search-wrapper {
                position: relative;
                flex: 1;
            }

            .search-wrapper i {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--txt3);
                font-size: 16px;
            }

            .search-input:focus {
                outline: none;
                border-color: var(--accent);
            }

            .filter-select {
                background: var(--bg3);
                border: 1px solid var(--border2);
                border-radius: var(--radius-sm);
                padding: 8px 14px;
                color: var(--txt2);
                font-size: 13px;
                font-family: 'Cairo', sans-serif;
                cursor: pointer;
            }

            /* ØªÙØ§Ø¯ÙŠ Ø¶ØºØ· ÙˆØªÙƒØ¯Ø³ Ø§Ù„Ø£Ø¹Ù…Ø¯Ø© ÙÙŠ Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ù…Ø­Ø§Ø¶Ø±Ø§Øª */
            .table-responsive {
                width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 900px;
            }

            th {
                background: var(--bg3);
                padding: 12px 18px;
                text-align: right;
                font-size: 11px;
                font-weight: 600;
                color: var(--txt3);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                white-space: nowrap;
            }

            td {
                padding: 14px 18px;
                font-size: 13px;
                color: var(--txt2);
                border-top: 1px solid var(--border);
                vertical-align: middle;
            }

            tr:hover td {
                background: rgba(255, 255, 255, 0.02);
                color: var(--txt);
            }

            .badge {
                display: inline-flex;
                align-items: center;
                padding: 3px 10px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 600;
            }

            .badge-green {
                background: rgba(6, 214, 160, 0.12);
                color: var(--green);
            }

            .badge-red {
                background: rgba(230, 57, 70, 0.12);
                color: var(--accent2);
            }

            .badge-gold {
                background: rgba(244, 162, 97, 0.12);
                color: var(--gold);
            }

            .badge-blue {
                background: rgba(67, 97, 238, 0.15);
                color: #7b9eff;
            }

            .badge-gray {
                background: rgba(255, 255, 255, 0.06);
                color: var(--txt3);
            }

            .avatar-circle {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--accent), var(--gold));
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 700;
                color: #fff;
            }

            .action-btns {
                display: flex;
                gap: 6px;
                flex-wrap: nowrap;
            }

            .action-btn {
                width: 30px;
                height: 30px;
                border-radius: 7px;
                border: 1px solid var(--border2);
                background: var(--bg3);
                color: var(--txt2);
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
                transition: all 0.15s;
            }

            .action-btn:hover {
                border-color: var(--accent);
                color: var(--accent2);
            }

            .action-btn.danger:hover {
                border-color: var(--accent);
                background: rgba(230, 57, 70, 0.12);
            }

            /* ===== FORM PANEL ===== */
            .form-panel {
                background: var(--bg2);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                overflow: hidden;
                max-width: 720px;
            }

            .form-panel-header {
                padding: 20px 24px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .form-panel-icon {
                width: 38px;
                height: 38px;
                border-radius: 9px;
                background: rgba(230, 57, 70, 0.12);
                color: var(--accent2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
            }

            .form-panel-header h3 {
                font-size: 15px;
                font-weight: 600;
            }

            .form-panel-header p {
                font-size: 12px;
                color: var(--txt3);
                margin-top: 2px;
            }

            .form-body {
                padding: 24px;
            }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
                margin-bottom: 16px;
            }

            .form-row.full {
                grid-template-columns: 1fr;
            }

            .form-field label {
                display: block;
                font-size: 12px;
                font-weight: 600;
                color: var(--txt3);
                margin-bottom: 7px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .form-field input,
            .form-field select,
            .form-field textarea {
                width: 100%;
                background: var(--bg3);
                border: 1px solid var(--border2);
                border-radius: var(--radius-sm);
                padding: 10px 14px;
                color: var(--txt);
                font-size: 14px;
                font-family: 'Cairo', sans-serif;
                transition: border-color 0.18s;
            }

            .form-field input:focus,
            .form-field select:focus,
            .form-field textarea:focus {
                outline: none;
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.12);
            }

            .form-field input[type="file"] {
                padding: 8px 12px;
                cursor: pointer;
            }

            .form-field select option {
                background: var(--bg3);
            }

            /* Grades pills */
            .grades-grid {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .grade-pill {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 7px 14px;
                border-radius: 20px;
                border: 1px solid var(--border2);
                background: var(--bg3);
                cursor: pointer;
                font-size: 12px;
                font-weight: 500;
                color: var(--txt2);
                transition: all 0.15s;
                user-select: none;
            }

            .grade-pill input[type="checkbox"] {
                display: none;
            }

            .grade-pill:hover {
                border-color: var(--accent);
                color: var(--txt);
            }

            .grade-pill.checked {
                background: rgba(230, 57, 70, 0.12);
                border-color: var(--accent);
                color: var(--accent2);
            }

            .grade-pill .dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                border: 1.5px solid currentColor;
            }

            .grade-pill.checked .dot {
                background: var(--accent2);
                border-color: var(--accent2);
            }

            .form-footer {
                padding: 16px 24px;
                border-top: 1px solid var(--border);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .btn-primary {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 22px;
                background: var(--accent);
                border: none;
                border-radius: var(--radius-sm);
                color: #fff;
                font-size: 14px;
                font-weight: 600;
                font-family: 'Cairo', sans-serif;
                cursor: pointer;
                transition: all 0.18s;
            }

            .btn-primary:hover {
                background: var(--accent2);
                transform: translateY(-1px);
            }

            .btn-ghost {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 18px;
                background: transparent;
                border: 1px solid var(--border2);
                border-radius: var(--radius-sm);
                color: var(--txt2);
                font-size: 14px;
                font-weight: 500;
                font-family: 'Cairo', sans-serif;
                cursor: pointer;
                transition: all 0.18s;
            }

            .btn-ghost:hover {
                border-color: var(--txt2);
                color: var(--txt);
            }

            /* ===== CODES SECTION ===== */
            .codes-tabs {
                display: flex;
                gap: 0;
                border-bottom: 1px solid var(--border);
                padding: 0 22px;
            }

            .code-tab {
                padding: 12px 20px;
                font-size: 13px;
                font-weight: 500;
                color: var(--txt3);
                cursor: pointer;
                border-bottom: 2px solid transparent;
                transition: all 0.15s;
                background: none;
                border-top: none;
                border-right: none;
                border-left: none;
                font-family: 'Cairo', sans-serif;
            }

            .code-tab.active {
                color: var(--accent2);
                border-bottom-color: var(--accent);
            }

            .codes-panel {
                display: none;
                padding: 20px;
            }

            .codes-panel.active {
                display: block;
            }

            .code-row {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                background: var(--bg3);
                border-radius: var(--radius-sm);
                border: 1px solid var(--border);
                margin-bottom: 8px;
                transition: border-color 0.15s;
            }

            .code-row:hover {
                border-color: var(--border2);
            }

            .code-mono {
                font-family: monospace;
                font-size: 15px;
                font-weight: 700;
                color: var(--txt);
                background: var(--bg2);
                padding: 4px 10px;
                border-radius: 6px;
                border: 1px solid var(--border2);
                letter-spacing: 1px;
            }

            .view-pips {
                display: flex;
                gap: 4px;
            }

            .pip {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                border: 1.5px solid var(--txt3);
            }

            .pip.filled {
                background: var(--teal);
                border-color: var(--teal);
            }

            /* ===== TEACHERS LIST ===== */
            .teacher-row {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 14px 18px;
                border-top: 1px solid var(--border);
            }

            .teacher-row:hover {
                background: rgba(255, 255, 255, 0.02);
            }

            .teacher-avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid var(--border2);
            }

            .teacher-avatar-placeholder {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--blue), var(--purple));
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 15px;
                font-weight: 700;
                color: #fff;
            }

            .teacher-info {
                flex: 1;
            }

            .teacher-name-text {
                font-size: 14px;
                font-weight: 600;
                color: var(--txt);
            }

            .teacher-meta {
                font-size: 12px;
                color: var(--txt3);
                margin-top: 3px;
            }

            .teacher-grades {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
            }

            .teacher-grade-tag {
                padding: 2px 8px;
                border-radius: 4px;
                font-size: 10px;
                background: rgba(67, 97, 238, 0.12);
                color: #7b9eff;
            }

            /* ===== GENERATE CODES ===== */
            .gen-result {
                background: var(--bg3);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 20px;
                margin-top: 20px;
            }

            .gen-codes-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
                margin-top: 16px;
            }

            .gen-code-chip {
                font-family: monospace;
                font-size: 14px;
                font-weight: 700;
                padding: 10px;
                background: var(--bg2);
                border: 1px solid var(--border2);
                border-radius: var(--radius-sm);
                text-align: center;
                color: var(--teal);
                letter-spacing: 1px;
            }

            /* ===== ONLINE ===== */
            .online-empty {
                text-align: center;
                padding: 60px 20px;
                color: var(--txt3);
            }

            .online-empty i {
                font-size: 48px;
                margin-bottom: 12px;
                display: block;
            }

            /* ===== EMPTY STATE ===== */
            .empty-state {
                text-align: center;
                padding: 60px 20px;
                color: var(--txt3);
            }

            .empty-state i {
                font-size: 48px;
                margin-bottom: 12px;
                display: block;
                color: var(--txt3);
            }

            .empty-state p {
                font-size: 14px;
            }

            /* ===== LOADING ===== */
            .skeleton {
                background: linear-gradient(90deg, var(--bg3) 25%, var(--surface) 50%, var(--bg3) 75%);
                background-size: 200% 100%;
                animation: shimmer 1.5s infinite;
                border-radius: 6px;
            }

            @keyframes shimmer {
                0% {
                    background-position: 200% 0;
                }

                100% {
                    background-position: -200% 0;
                }
            }

            /* ===== TOAST ===== */
            #toast-container {
                position: fixed;
                bottom: 24px;
                right: 24px;
                /* ØªÙ… ØªØ¹Ø¯ÙŠÙ„ Ø§Ù„Ø§ØªØ¬Ø§Ù‡ Ù…Ù† Ø§Ù„ÙŠØ³Ø§Ø± Ù„Ù„ÙŠÙ…ÙŠÙ† Ù„Ù…Ù†Ø¹ Ø§Ù„ØªØ¯Ø§Ø®Ù„ */
                z-index: 9999;
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .toast {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 18px;
                background: var(--bg2);
                border: 1px solid var(--border2);
                border-radius: var(--radius-sm);
                box-shadow: var(--shadow);
                font-size: 13px;
                color: var(--txt);
                animation: slideIn 0.25s ease;
                min-width: 260px;
            }

            .toast.success {
                border-right: 3px solid var(--green);
            }

            .toast.error {
                border-right: 3px solid var(--accent);
            }

            .toast.info {
                border-right: 3px solid var(--blue);
            }

            @keyframes slideIn {
                from {
                    transform: translateY(20px);
                    opacity: 0;
                }

                to {
                    transform: none;
                    opacity: 1;
                }
            }

            /* ===== CONFIRM MODAL ===== */
            .modal-bg {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.65);
                z-index: 999;
                align-items: center;
                justify-content: center;
            }

            .modal-bg.open {
                display: flex;
            }

            .modal-box {
                background: var(--bg2);
                border: 1px solid var(--border2);
                border-radius: var(--radius);
                padding: 28px 32px;
                max-width: 380px;
                width: 90%;
                text-align: center;
            }

            .modal-icon {
                font-size: 42px;
                margin-bottom: 12px;
            }

            .modal-box h3 {
                font-size: 16px;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .modal-box p {
                font-size: 13px;
                color: var(--txt3);
                margin-bottom: 24px;
            }

            .modal-actions {
                display: flex;
                gap: 10px;
                justify-content: center;
            }

            /* ===== RESPONSIVE ===== */
            @media (max-width: 900px) {
                .kpi-grid {
                    grid-template-columns: 1fr 1fr;
                }

                .form-row {
                    grid-template-columns: 1fr;
                }
            }

            /* ===== MASAR NAVBAR ===== */
            .masar-navbar {
                background: var(--bg2);
                border-bottom: 1px solid var(--border);
                position: sticky;
                top: 0;
                z-index: 95;
                padding: 0 24px;
                box-shadow: 0 2px 16px rgba(0, 0, 0, 0.15);
            }

            .masar-nav-inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                max-width: 100%;
                gap: 20px;
            }

            .masar-logo {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                flex-shrink: 0;
            }

            .masar-logo-icon {
                width: 36px;
                height: 36px;
                background: linear-gradient(135deg, var(--accent), var(--gold));
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
                font-weight: 900;
                color: #fff;
            }

            .masar-logo-text {
                font-size: 15px;
                font-weight: 700;
                color: var(--txt);
                white-space: nowrap;
            }

            .masar-badge {
                background: rgba(230, 57, 70, 0.15);
                color: var(--accent2);
                border: 1px solid rgba(230, 57, 70, 0.3);
                padding: 2px 8px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 600;
            }

            .masar-nav-links {
                display: flex;
                align-items: center;
                gap: 4px;
                flex: 1;
                justify-content: center;
            }

            .masar-link {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 8px 14px;
                border-radius: var(--radius-sm);
                color: var(--txt2);
                text-decoration: none;
                font-size: 13px;
                font-weight: 500;
                transition: all 0.15s;
            }

            .masar-link:hover {
                background: var(--bg3);
                color: var(--txt);
            }

            .masar-nav-actions {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-shrink: 0;
            }

            /* Theme Toggle Switch */
            .masar-theme-toggle {
                display: flex;
                align-items: center;
                gap: 8px;
                cursor: pointer;
                padding: 6px 10px;
                border-radius: 20px;
                border: 1px solid var(--border2);
                background: var(--bg3);
                transition: all 0.2s;
                user-select: none;
            }

            .masar-theme-toggle:hover {
                border-color: var(--accent);
            }

            .theme-icon {
                font-size: 14px;
                line-height: 1;
            }

            .toggle-track {
                width: 34px;
                height: 18px;
                background: var(--bg2);
                border-radius: 9px;
                border: 1px solid var(--border2);
                position: relative;
                transition: background 0.3s;
            }

            .toggle-thumb {
                width: 12px;
                height: 12px;
                background: var(--accent);
                border-radius: 50%;
                position: absolute;
                top: 2px;
                right: 2px;
                transition: right 0.3s;
            }

            body.light-mode .toggle-thumb {
                right: 18px;
            }

            body.light-mode .toggle-track {
                background: rgba(230, 57, 70, 0.1);
            }

            .masar-admin-info {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 6px 12px;
                border-radius: var(--radius-sm);
                background: var(--bg3);
                border: 1px solid var(--border);
            }

            .admin-avatar {
                font-size: 18px;
            }

            .admin-name {
                font-size: 13px;
                font-weight: 600;
                color: var(--txt);
            }

            .masar-logout-btn {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 8px 14px;
                border-radius: var(--radius-sm);
                background: rgba(230, 57, 70, 0.1);
                border: 1px solid rgba(230, 57, 70, 0.25);
                color: var(--accent2);
                cursor: pointer;
                font-size: 13px;
                font-weight: 500;
                font-family: 'Cairo', sans-serif;
                transition: all 0.18s;
            }

            .masar-logout-btn:hover {
                background: rgba(230, 57, 70, 0.2);
            }

            /* Theme icon visibility */
            .masar-theme-toggle .sun {
                opacity: 0.5;
            }

            .masar-theme-toggle .moon {
                opacity: 1;
            }

            body.light-mode .masar-theme-toggle .sun {
                opacity: 1;
            }

            body.light-mode .masar-theme-toggle .moon {
                opacity: 0.5;
            }

            body {
                display: flex;
                flex-direction: column;
            }

            .sidebar {
                position: fixed;
                top: 64px;
                right: 0;
                bottom: 0;
                z-index: 100;
            }

            .main {
                margin-top: 0;
            }

            .topbar {
                background: var(--bg2);
                border-bottom: 1px solid var(--border);
                padding: 0 32px;
                height: 64px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 90;
            }

            .topbar-title {
                font-size: 18px;
                font-weight: 700;
                color: var(--txt);
            }

            .topbar-subtitle {
                font-size: 12px;
                color: var(--txt3);
                margin-top: 2px;
            }

            .topbar-actions {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .topbar-btn {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 16px;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border2);
                background: var(--bg3);
                color: var(--txt2);
                cursor: pointer;
                font-size: 13px;
                font-weight: 500;
                font-family: 'Cairo', sans-serif;
                transition: all 0.18s;
            }

            .topbar-btn:hover {
                border-color: var(--accent);
                color: var(--accent2);
            }

            .topbar-btn.primary {
                background: var(--accent);
                border-color: var(--accent);
                color: #fff;
            }

            .topbar-btn.primary:hover {
                background: var(--accent2);
            }

            /* ===== CONTENT ===== */
            .content {
                padding: 28px 32px;
                flex: 1;
            }

            .section {
                display: none;
            }

            .section.active {
                display: block;
            }

            /* ===== EDIT VIDEO MODAL ===== */
            .modal-bg {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.65);
                z-index: 999;
                align-items: center;
                justify-content: center;
            }

            .modal-bg.open {
                display: flex;
            }

            .modal-box {
                background: var(--bg2);
                border: 1px solid var(--border2);
                border-radius: var(--radius);
                padding: 28px 32px;
                max-width: 380px;
                width: 90%;
                text-align: center;
            }

            .sidebar-toggle-btn {
                display: none;
                background: none;
                border: none;
                color: var(--txt);
                font-size: 20px;
                cursor: pointer;
                margin-left: 10px;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                border-radius: 8px;
                transition: background 0.2s;
            }
            .sidebar-toggle-btn:hover {
                background: var(--bg3);
            }

            /* ===== RESPONSIVE MEDIA QUERIES FOR ADMIN PANEL ===== */
            @media (max-width: 992px) {
                .sidebar-toggle-btn {
                    display: flex !important; /* Show hamburger button */
                }
                .sidebar {
                    right: -260px; /* Hide sidebar offscreen on mobile */
                    transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                    box-shadow: -5px 0 25px rgba(0,0,0,0.3);
                }
                .sidebar.active {
                    right: 0 !important; /* Slide in sidebar */
                }
                .main {
                    margin-right: 0 !important; /* Remove main margin */
                }
                .kpi-grid {
                    grid-template-columns: 1fr 1fr !important; /* 2 columns on tablet */
                }
            }

            @media (max-width: 768px) {
                .masar-logo-text {
                    display: none !important; /* Hide logo text */
                }
                .masar-nav-links {
                    display: none !important; /* Hide header navigation links */
                }
                .masar-admin-info {
                    display: none !important; /* Hide admin badge */
                }
                .masar-navbar {
                    padding: 0 16px !important;
                }
            }

            @media (max-width: 576px) {
                .kpi-grid {
                    grid-template-columns: 1fr !important; /* 1 column on mobile */
                }
                .form-row {
                    grid-template-columns: 1fr !important; /* stack forms */
                    gap: 12px !important;
                }
                .content {
                    padding: 16px !important;
                }
                .topbar {
                    padding: 0 16px !important;
                }
                .modal-box {
                    padding: 20px !important;
                    width: 95% !important;
                }
                #section-exams > div,
                #section-teachers > div,
                #section-banners > div {
                    grid-template-columns: 1fr !important;
                    gap: 20px !important;
                }
            }
        </style>
