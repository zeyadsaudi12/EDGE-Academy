                    btnElement.textContent = 'ðŸ”“ Ø¥Ù„ØºØ§Ø¡ Ø§Ù„Ø­Ø¸Ø± ÙˆØªÙØ¹ÙŠÙ„ Ø§Ù„ÙÙŠØ¯ÙŠÙˆ';
                }
