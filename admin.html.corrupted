            async function deleteBanner(id) {
                showModal('Ø­Ø°Ù Ø§Ù„Ø¥Ø¹Ù„Ø§Ù†', 'Ù‡Ù„ ØªØ±ÙŠØ¯ Ø­Ø°Ù Ù‡Ø°Ø§ Ø§Ù„Ø¥Ø¹Ù„Ø§Ù† Ù†Ù‡Ø§Ø¦ÙŠØ§Ù‹ØŸ', async () => {
