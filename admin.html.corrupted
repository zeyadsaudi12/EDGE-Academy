            // ===== LOAD DATA =====
        async function loadAll() {
        try {
            const [uR, cR, vR, tR, fcR, violR] = await Promise.all([
                fetch(`${API}/api/users`), fetch(`${API}/api/codes`),
                fetch(`${API}/api/videos`), fetch(`${API}/api/teachers`),
                fetch(`${API}/api/teachers/follower-counts`),
                fetch(`${API}/api/security/reports`).catch(() => null)
            ]);
            _users = await uR.json();
            _codes = await cR.json();
            _videos = await vR.json();
            _teachers = await tR.json();
            _followerCounts = await fcR.json();
            if (violR) {
                const violData = await violR.json();
                _violations = violData.reports || [];
            }
        } catch (e) {
            _users = JSON.parse(localStorage.getItem('users')) || [];
            _codes = JSON.parse(localStorage.getItem('codes')) || [];
            _videos = JSON.parse(localStorage.getItem('videos')) || [];
            _teachers = [];
            _followerCounts = {};
            _violations = [];
            toast('ØªØ¹Ø°Ù‘Ø± Ø§Ù„Ø§ØªØµØ§Ù„ Ø¨Ø§Ù„Ø®Ø§Ø¯Ù…ØŒ Ø§Ù„Ø¨ÙŠØ§Ù†Ø§Øª Ù…Ø­Ù„ÙŠØ©', 'error');
        }
        updateAll();
    }

            async function refreshData() {
                toast('Ø¬Ø§Ø±ÙŠ ØªØ­Ø¯ÙŠØ« Ø§Ù„Ø¨ÙŠØ§Ù†Ø§Øª...', 'info');
                await loadAll();
                toast('ØªÙ… ØªØ­Ø¯ÙŠØ« Ø§Ù„Ø¨ÙŠØ§Ù†Ø§Øª Ø¨Ù†Ø¬Ø§Ø­', 'success');
            }

            function updateAll() {
        updateSidebarStats();
        renderOverviewTable();
        renderUsersTable();
        populateCodesFilters();
        renderCodesPanels();
        renderTeachersAdmin();
