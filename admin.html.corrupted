            // ===== BANNERS =====
            function previewBannerImage(input) {
                const box = document.getElementById('banner-preview-box');
                const img = document.getElementById('banner-preview-img');
                if (input.files && input.files[0]) {
                    const reader = new FileReader();
                    reader.onload = e => { img.src = e.target.result; box.style.display = 'block'; };
                    reader.readAsDataURL(input.files[0]);
                }
            }

            async function uploadBanner() {
                const fileInput = document.getElementById('banner-image-file');
                const title = document.getElementById('banner-title').value.trim();
                const link = document.getElementById('banner-link').value.trim();
                const order = document.getElementById('banner-order').value;

                if (!fileInput.files || !fileInput.files[0]) {
                    toast('ÙŠØ±Ø¬Ù‰ Ø§Ø®ØªÙŠØ§Ø± ØµÙˆØ±Ø©', 'error'); return;
                }

                const formData = new FormData();
                formData.append('image', fileInput.files[0]);
                formData.append('title', title);
                formData.append('link', link);
                formData.append('order', order);

                try {
                    toast('Ø¬Ø§Ø±ÙŠ Ø±ÙØ¹ Ø§Ù„Ø¥Ø¹Ù„Ø§Ù†...', 'info');
                    const res = await fetch(`${API}/api/banners`, { method: 'POST', body: formData });
                    const d = await res.json();
                    if (d.success) {
                        toast('ØªÙ… Ø±ÙØ¹ Ø§Ù„Ø¥Ø¹Ù„Ø§Ù† Ø¨Ù†Ø¬Ø§Ø­ âœ…', 'success');
